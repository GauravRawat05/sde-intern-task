// ==============================================================================
// TSCONFIG CONFIGURATION (api/tsconfig.json)
// ==============================================================================
// This file configures the TypeScript compiler behavior for the backend worker api.
// It specifies strict type checking, ES2022 compatibility libraries, and ensures
// the compiler targets Cloudflare Workers execution standards.
// ==============================================================================
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
