// ==============================================================================
// TSCONFIG CONFIGURATION (web/tsconfig.json)
// ==============================================================================
// This file configures the TypeScript compiler for the frontend React application.
// It specifies strict type-checking, JSX processing using react-jsx, browser environment
// libraries (DOM, DOM.Iterable), and configures type definitions for Vite client assets.
// ==============================================================================
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
